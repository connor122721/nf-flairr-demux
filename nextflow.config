// ============================================================================
// nf-flairr-demux: Nextflow configuration
// ============================================================================

// Default parameters
params {
    samplesheet = null     // CSV/TSV: sample, barcode, FASTQ/BAM path per row (replaces input_* + biosample)
    input_bams = null      // OR HiFi BAM(s) / a folder of them (+ biosample)
    input_fastqs = null    // OR FASTQ(s) / a folder of them (+ biosample)
    kinnex = true          // run skera on BAM inputs first; false = demux BAMs as they are
    mas_primers = null     // only needed for BAMs with kinnex = true
    tso_window = 1         // positions from the read start searched for the TSO
    bc_window = 1          // positions from the read end searched for the sample barcode
    bc_trim_len = 0        // trim only this many barcode bases (0 = whole entry; 16 keeps a C primer)
    barcodes = null
    biosample = null
    outdir = 'results'
    mismatches = 3
    max_bc_dist = 0
    no_trim = false
    threads = 12
    memory = '50 GB'
    chunk_size = 5000
    partition = "compute"
}

// Define profiles for slurm execution environment
profiles {

    // SLURM System
    slurm {

        executor {
            name = 'slurm'
            //queueSize = 100
            submitRateLimit = '30/1min'
        }

        process {
            executor = 'slurm' // Use SLURM as the executor
            clusterOptions = "--partition=${params.partition} --oversubscribe" // SLURM partition, account
            cpus = "${params.threads}" // Number of threads per job
            memory = "${params.memory}" // Memory per job
            errorStrategy = 'ignore'
        } 

        withLabel: 'process_medium' {
            cpus = params.threads
            memory = '50 GB'
            time = '8h'
        }        
    }

    // Apptainer profile
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }

    // Singularity profile
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}

// Execution reports
report {
    enabled = true
    file = "${params.outdir}/reports/execution_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/reports/timeline.html"
    overwrite = true
}

// Manifest
manifest {
    name = 'nf-flairr-demux'
    author = 'Connor Murray'
    description = 'FLAIRR-seq sample demultiplexing from a samplesheet, HiFi BAMs (with optional skera deconcatenation) or FASTQs'
    version = '1.2.1'
    nextflowVersion = '>=23.04.0'
}
