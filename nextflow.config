// ============================================================================
// nf-flairr-demux: Nextflow configuration
// ============================================================================

// Default parameters
params {
    input_bams = null      // raw Kinnex HiFi BAM(s) or a folder of them (runs skera first)
    input_fastqs = null    // OR deconcatenated FASTQ(s) / a folder of them (skera skipped)
    mas_primers = null     // only needed with input_bams
    barcodes = null
    biosample = null
    outdir = 'results'
    mismatches = 3
    max_bc_dist = 0
    no_trim = false
    threads = 12
    memory = '50 GB'
    chunk_size = 5000
    partition = "compute"
}

// Define profiles for slurm execution environment
profiles {

    // SLURM System
    slurm {

        executor {
            name = 'slurm'
            //queueSize = 100
            submitRateLimit = '30/1min'
        }

        process {
            executor = 'slurm' // Use SLURM as the executor
            clusterOptions = "--partition=${params.partition} --oversubscribe" // SLURM partition, account
            cpus = "${params.threads}" // Number of threads per job
            memory = "${params.memory}" // Memory per job
            errorStrategy = 'ignore'
        } 

        withLabel: 'process_medium' {
            cpus = params.threads
            memory = '50 GB'
            time = '8h'
        }        
    }

    // Apptainer profile
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }

    // Singularity profile
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}

// Execution reports
report {
    enabled = true
    file = "${params.outdir}/reports/execution_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/reports/timeline.html"
    overwrite = true
}

// Manifest
manifest {
    name = 'nf-flairr-demux'
    author = 'Connor Murray'
    description = 'Kinnex FLAIRR-seq sample demultiplexing from HiFi BAMs (with skera deconcatenation) or from FASTQs'
    version = '1.1.0'
    nextflowVersion = '>=23.04.0'
}
